APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum personal access token 有效期（分鐘），預設 90 天
# SANCTUM_TOKEN_EXPIRATION=129600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# 必須 > worker 的 --timeout（如 180），否則慢 job 會在 retry_after 被重複派發
REDIS_QUEUE_RETRY_AFTER=210

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MICRO_HOST_CHANNEL=micro:heartbeat
MICRO_HOST_TTL_KEY=micro:online
MICRO_HOST_TTL=120

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GCP_PROJECT_ID=
GCP_LOCATION=us-central1
VERTEX_APPLICATION_CREDENTIALS=
GCP_GEMINI_MODEL=gemini-2.5-flash
GCP_IMAGE_MODEL=imagen-4.0-generate-001
ARTICLE_GENERATION_RATE_LIMIT_SECONDS=3600

GEMINI_API_KEY=
# AI Studio 有地區限制；prod 主機在不支援地區時，設成支援地區的中繼代理（如 GCP VM tinyproxy）
# 例：http://<vm-internal-ip>:3128。留空＝直連（dev 用）
GEMINI_PROXY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODELS=gemini-3-flash,gemini-2.5-flash-lite,gemini-2.5-flash

# 共用圖片生成（GeneratesImage，角色立繪等）的 key-based Gemini model（待填，如 nano-banana 系列）。
# 空＝GeminiImageGenerationService 會丟例外。文章封面圖另走 Vertex（上方 GCP_*），兩者獨立。
GEMINI_IMAGE_MODEL=

# ── LLM 抽象層（多 provider，可在 Admin > System 頁依用途切換）─────────────
# Nvidia NIM（OpenAI 相容）
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Ollama（本地，無 auth）
OLLAMA_HOST=http://localhost:11434
# System 頁 model 下拉的候選清單（逗號分隔）
LLM_GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
LLM_NVIDIA_MODELS=meta/llama-3.3-70b-instruct,google/gemma-2-27b-it
LLM_OLLAMA_MODELS=llama3.1,qwen2.5
# 各用途預設 provider/model（runtime 可被 System 頁覆蓋，留空則用以下）
# LLM_STORY_PROVIDER=gemini
# LLM_STORY_MODEL=gemini-2.5-flash
# LLM_STORY_STATE_PROVIDER=gemini
# LLM_STORY_STATE_MODEL=gemini-2.5-flash
# LLM_CHARACTER_PROVIDER=gemini
# LLM_CHARACTER_MODEL=gemini-2.5-flash
# LLM_RESUME_PROVIDER=gemini
# LLM_RESUME_MODEL=gemini-2.5-flash
# LLM_RAG_PROVIDER=gemini
# LLM_RAG_MODEL=gemini-2.5-flash

# LINE integration settings
# Internal API key used by Flask -> Laravel requests (header: X-Line-Bot-Key)
LINE_BOT_INTERNAL_API_KEY=
# Flask webhook endpoint for article-ready events (Laravel -> Flask)
LINE_BOT_ARTICLE_READY_WEBHOOK_URL=
# Optional API key sent by Laravel -> Flask webhook (header: X-Line-Webhook-Key)
LINE_BOT_OUTBOUND_WEBHOOK_KEY=

# HMAC secret for verifying inbound requests from Flask -> Laravel
LINE_BOT_INBOUND_HMAC_SECRET=
# HMAC secret for signing outbound webhook requests from Laravel -> Flask
LINE_BOT_OUTBOUND_HMAC_SECRET=
# Set true to require HMAC headers on inbound requests; false allows gradual rollout
LINE_BOT_HMAC_REQUIRED=false
# Allowed clock skew (seconds) for HMAC timestamp validation and nonce TTL
LINE_BOT_HMAC_MAX_SKEW_SECONDS=300

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=
VITE_AUTH_USE_CSRF=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_URL=
SOCIAL_AUTH_REDIRECT_PATH=

VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=

RSA_PRIVATE_KEY_PATH=storage/app/private/private.pem
RSA_PUBLIC_KEY_PATH=storage/app/private/public.pem

MINI_ORCH_HOST=

WS_ALLOWED_ORIGINS=
WS_ADDR=127.0.0.1:9001
WS_MGMT_ADDR=127.0.0.1:9002

MCP_SERVER_VERSION=1.0.0

# RAG（Google Drive 來源 + vecgen 向量庫）
RAG_DRIVE_FOLDER_ID=
RAG_DRIVE_CREDENTIALS_PATH=

# 圖片儲存（本地 webp pipeline）
# 功能開關：預設全關，需明確開啟（總開關關=路由 404；子開關關=403）
IMAGE_ENABLED=false
IMAGE_UPLOAD_ENABLED=false
IMAGE_PUBLIC_UPLOAD_ENABLED=false
IMAGE_URL_DOWNLOAD_ENABLED=false
# 限制 / 編碼
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_MEGAPIXELS=20
IMAGE_WEBP_QUALITY=82
# URL 下載（SSRF）
IMAGE_DOWNLOAD_TIMEOUT=15
IMAGE_MAX_REDIRECTS=3
IMAGE_DOWNLOAD_USER_AGENT=
# public 檔數上限與計數（prod 建議 redis）
IMAGE_PUBLIC_MAX_FILES=10000
IMAGE_PUBLIC_COUNT_DRIVER=scan
IMAGE_PUBLIC_COUNT_REDIS_KEY=image:public:shard_counts
