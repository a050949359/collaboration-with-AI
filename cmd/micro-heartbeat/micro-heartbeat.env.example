# micro-heartbeat 環境變數 — 複製成 micro-heartbeat.env 後填入實際值
#
# 專案主機的 ZeroTier IP（必填）
REDIS_HOST=10.147.20.xxx
REDIS_PORT=6379
# REDIS_PASSWORD=yourpassword

# Redis key 與 TTL（需與 Laravel config/micro-host.php 一致）
REDIS_KEY=micro:online
REDIS_TTL=120

# 心跳間隔（秒）——必須小於 REDIS_TTL，否則 key 會在兩次心跳間過期
HEARTBEAT_INTERVAL=60

# Proxmox node 名稱
PVE_NODE=pve
